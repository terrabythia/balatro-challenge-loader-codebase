# Supabase PostgreSQL (get from Supabase dashboard → Project Settings → Database)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-app.fly.dev/api/auth/callback

# Auth
JWT_SECRET=your_random_64_char_hex_string
